<Application x:Class="EarDial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#F21B1D23" />
        <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F5F7" />
        <SolidColorBrush x:Key="SecondaryText" Color="#9AA3AF" />
        <SolidColorBrush x:Key="Accent" Color="#6AA9FF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </Application.Resources>
</Application>