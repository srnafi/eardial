<Window x:Class="EarDial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EarDial"
        Icon="Assets/eardial.ico"
        Width="330"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False">

    <Border x:Name="Card"
            CornerRadius="14"
            Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Padding="18,16,18,18"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">

        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh devices" Click="Refresh_Click" />
                <MenuItem x:Name="TopmostMenu" Header="Always on top" IsCheckable="True" IsChecked="True" Click="Topmost_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="EarDial"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource CloseButton}"
                        Content="&#x2715;"
                        Click="Exit_Click" />
            </DockPanel>

            <ComboBox x:Name="DeviceBox"
                      Margin="0,10,0,0"
                      Height="26"
                      Style="{StaticResource DeviceSelector}"
                      SelectionChanged="DeviceBox_SelectionChanged" />

            <TextBlock x:Name="HintText"
                       Margin="0,10,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryText}"
                       Visibility="Collapsed" />

            <StackPanel x:Name="SliderHost" Margin="0,10,0,0" />

            <Border Height="1" Margin="7,14,7,0" Background="#1EFFFFFF" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mute"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />

                <ToggleButton x:Name="MuteBox"
                              Grid.Column="1"
                              Margin="7,0,0,0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource WidgetToggle}"
                              Click="Mute_Click" />

                <TextBlock x:Name="MuteState"
                           Grid.Column="2"
                           Text="Off"
                           FontSize="11"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}"
                           Typography.NumeralAlignment="Tabular" />
            </Grid>
        </StackPanel>
    </Border>
</Window>