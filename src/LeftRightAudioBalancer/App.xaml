<Application x:Class="LeftRightAudioBalancer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LeftRightAudioBalancer">
    <Application.Resources>

        <!-- ===================== palette (v3) ===================== -->
        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F51C2029" Offset="0" />
            <GradientStop Color="#F512151B" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="PopupBackground" Color="#1C2029" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6FA" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB3C2" />
        <SolidColorBrush x:Key="DimText" Color="#6F7889" />
        <SolidColorBrush x:Key="FaintText" Color="#5A6272" />
        <SolidColorBrush x:Key="Accent" Color="#5AA2FF" />
        <SolidColorBrush x:Key="Accent2" Color="#9B7BFF" />
        <SolidColorBrush x:Key="Hairline" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="TrackFill" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ChipFill" Color="#0CFFFFFF" />
        <SolidColorBrush x:Key="ChipBorder" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="Warn" Color="#FFB547" />
        <SolidColorBrush x:Key="Good" Color="#4ADE80" />
        <SolidColorBrush x:Key="Bad" Color="#F08A85" />

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5AA2FF" Offset="0" />
            <GradientStop Color="#9B7BFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MasterGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B95A5" Offset="0" />
            <GradientStop Color="#C9D2DE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BigNumber" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F6FA" Offset="0" />
            <GradientStop Color="#AAB3C2" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DeviceTileFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#305AA2FF" Offset="0" />
            <GradientStop Color="#309B7BFF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>

        <!-- ===================== header icon buttons ===================== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="28" Height="28" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0CFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <!-- Later trigger wins, so the latched state survives hover. -->
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bg" Property="Background" Value="#1A5AA2FF" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== device selector =====================
             Icon tile + name + subtitle + a 16 px chevron. The subtitle and the
             bluetooth/speaker glyph come from DeviceUi attached properties. -->
        <Style x:Key="DeviceSelector" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}" />

                            <Grid Margin="5,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="30" Height="30" CornerRadius="10"
                                        Background="{StaticResource DeviceTileFill}"
                                        BorderBrush="#405AA2FF" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Viewbox x:Name="SpeakerGlyph" Width="15" Height="15">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,15 L4,12 A8,8 0 0 1 20,12 L20,15"
                                                      Stroke="{StaticResource Accent}" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Rectangle Canvas.Left="2" Canvas.Top="14" Width="4" Height="7"
                                                           RadiusX="1.6" RadiusY="1.6"
                                                           Stroke="{StaticResource Accent}" StrokeThickness="1.9" />
                                                <Rectangle Canvas.Left="18" Canvas.Top="14" Width="4" Height="7"
                                                           RadiusX="1.6" RadiusY="1.6"
                                                           Stroke="{StaticResource Accent}" StrokeThickness="1.9" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="BluetoothGlyph" Width="15" Height="15" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M7,7 L17,17 L12,21 L12,3 L17,7 L7,17"
                                                      Stroke="{StaticResource Accent}" StrokeThickness="1.9"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path=(local:DeviceUi.Subtitle), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="10.5" Margin="0,1,0,0"
                                               Foreground="{StaticResource DimText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 16 px chevron; the old 9 px glyph was too small to read. -->
                                <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,9 L12,15 L18,9"
                                              Stroke="{StaticResource SecondaryText}" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource PopupBackground}"
                                        BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12"
                                        Margin="0,6,0,0" Padding="0,4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:DeviceUi.IsBluetooth" Value="True">
                                <Setter TargetName="SpeakerGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="BluetoothGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== sliders =====================
             Thumb width equals dot width so the fill meets the dot and the dot
             reaches both ends of the track. The ring is a negative-margin
             overhang (not clipped) that grows on hover and drag. The lighter
             bar inside the fill is the live level meter (DeviceUi.Meter). -->
        <Style x:Key="WidgetSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Border Height="8" CornerRadius="4" Margin="9,0"
                                    Background="{StaticResource TrackFill}" VerticalAlignment="Center" />

                            <Track x:Name="PART_Track" VerticalAlignment="Center" Margin="9,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" CornerRadius="4" ClipToBounds="True"
                                                        Background="{StaticResource AccentGradient}">
                                                    <Border CornerRadius="4" Background="#3DFFFFFF"
                                                            HorizontalAlignment="Stretch"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Path=(local:DeviceUi.Meter), RelativeSource={RelativeSource AncestorType=Slider}}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="28" Background="Transparent">
                                                    <Grid Width="18" Height="18">
                                                        <Ellipse x:Name="Ring" Margin="-4" Fill="#225AA2FF" />
                                                        <Ellipse Fill="#FFFFFF" />
                                                    </Grid>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Margin" Value="-6" />
                                                        <Setter TargetName="Ring" Property="Fill" Value="#335AA2FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Ring" Property="Margin" Value="-8" />
                                                        <Setter TargetName="Ring" Property="Fill" Value="#335AA2FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Master is a scale, not a third ear: thinner track, smaller knob, grey fill. -->
        <Style x:Key="MasterSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Margin="7,0"
                                    Background="{StaticResource TrackFill}" VerticalAlignment="Center" />

                            <Track x:Name="PART_Track" VerticalAlignment="Center" Margin="7,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3"
                                                        Background="{StaticResource MasterGradient}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14" Height="28" Background="Transparent">
                                                    <Grid Width="14" Height="14">
                                                        <Ellipse x:Name="Ring" Margin="-4" Fill="#225AA2FF" />
                                                        <Ellipse Fill="#FFFFFF" />
                                                    </Grid>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Margin" Value="-6" />
                                                        <Setter TargetName="Ring" Property="Fill" Value="#335AA2FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Ring" Property="Margin" Value="-8" />
                                                        <Setter TargetName="Ring" Property="Fill" Value="#335AA2FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== footer pills ===================== -->
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Padding="11,0"
                                Background="{StaticResource ChipFill}"
                                BorderBrush="{StaticResource ChipBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="14" Padding="11,0"
                                Background="{StaticResource ChipFill}"
                                BorderBrush="{StaticResource ChipBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A5AA2FF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#405AA2FF" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== drawer ===================== -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{StaticResource TrackFill}"
                                BorderBrush="{StaticResource ChipBorder}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="1,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="{StaticResource ChipFill}" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="11,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillApplied" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Foreground" Value="{StaticResource Good}" />
            <Setter Property="Background" Value="#144ADE80" />
            <Setter Property="BorderBrush" Value="#504ADE80" />
        </Style>

        <!-- Amber "Fix" button on the symptom banner: filled, dark text. -->
        <Style x:Key="ChipAction" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#1A1200" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,0"
                                Background="{StaticResource Warn}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quit: full-width, last row of the settings drawer. -->
        <Style x:Key="QuitButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Bad}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10"
                                Background="{StaticResource ChipFill}"
                                BorderBrush="{StaticResource ChipBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AF08A85" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#40F08A85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click menu keeps its own Quit as a shortcut. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,6">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
