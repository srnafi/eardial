<Window x:Class="LeftRightAudioBalancer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Left Right Audio Balancer"
        Icon="Assets/leftrightaudiobalancer.ico"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False">

    <Border x:Name="Card"
            CornerRadius="22"
            Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1"
            Padding="14,12,14,12"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">

        <Border.ContextMenu>
            <ContextMenu Background="{StaticResource PopupBackground}"
                         BorderBrush="#1FFFFFFF"
                         BorderThickness="1"
                         Padding="4">
                <MenuItem Header="Quit LeftRightAudioBalancer" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>

            <!-- ===================== header ===================== -->
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="DeviceBox"
                          Grid.Column="0"
                          Margin="-5,0,0,0"
                          Style="{StaticResource DeviceSelector}"
                          SelectionChanged="DeviceBox_SelectionChanged" />

                <Button x:Name="PinButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Margin="6,0,0,0"
                        Tag="off"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="Lock position"
                        Click="Pin_Click">
                    <!-- A padlock, not a drawing pin. The pin used to mean
                         always-on-top; now it means the card cannot be dragged,
                         so the glyph has to say "locked". -->
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8,11 L8,8.2 A4,4 0 0 1 16,8.2 L16,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Rectangle Canvas.Left="5.5" Canvas.Top="11" Width="13" Height="9.5"
                                       RadiusX="2.2" RadiusY="2.2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.9" />
                            <Path Data="M12,14.5 L12,17.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="GearButton"
                        Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Margin="2,0,0,0"
                        Tag="off"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="Settings"
                        Click="Gear_Click">
                    <!-- Sliders, not a gear: a gear turns to mush at 14 px. -->
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,7 L21,7 M3,12 L21,12 M3,17 L21,17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="6" Canvas.Top="4.6" Width="4.8" Height="4.8"
                                     Fill="#12151B"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.8" />
                            <Ellipse Canvas.Left="13.2" Canvas.Top="9.6" Width="4.8" Height="4.8"
                                     Fill="#12151B"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.8" />
                            <Ellipse Canvas.Left="8.6" Canvas.Top="14.6" Width="4.8" Height="4.8"
                                     Fill="#12151B"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.8" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- ===================== symptom banner ===================== -->
            <Border x:Name="Chip"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"
                    CornerRadius="12"
                    Background="#1AFFB547"
                    BorderBrush="#38FFB547"
                    BorderThickness="1"
                    Padding="10,8,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <!-- warning triangle -->
                            <Path x:Name="ChipBang"
                                  Data="M12,8.5 L12,13.5 M12,17.4 L12,17.6"
                                  Stroke="{StaticResource Warn}"
                                  StrokeThickness="2.1"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path x:Name="ChipGlyph"
                                  Data="M10.3,3.9 L2.5,18 A2,2 0 0 0 4.2,21 L19.8,21 A2,2 0 0 0 21.5,18 L13.7,3.9 A2,2 0 0 0 10.3,3.9 Z"
                                  Stroke="{StaticResource Warn}"
                                  StrokeThickness="1.9"
                                  StrokeLineJoin="Round" />
                            <!-- applied -->
                            <Path x:Name="ChipCheck"
                                  Visibility="Collapsed"
                                  Data="M20,6 L9,17 L4,12"
                                  Stroke="{StaticResource Accent}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <!-- info -->
                            <Ellipse x:Name="ChipInfoRing"
                                     Visibility="Collapsed"
                                     Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                     Stroke="{StaticResource Accent}"
                                     StrokeThickness="1.9" />
                            <Path x:Name="ChipInfoDot"
                                  Visibility="Collapsed"
                                  Data="M12,16.5 L12,11 M12,7.9 L12,8.1"
                                  Stroke="{StaticResource Accent}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock x:Name="ChipText"
                               Grid.Column="1"
                               FontSize="11.5"
                               Foreground="{StaticResource Warn}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button x:Name="ChipAction"
                            Grid.Column="2"
                            Style="{StaticResource ChipAction}"
                            Content="Fix"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="ChipFix_Click" />
                </Grid>
            </Border>

            <!-- ===================== hero readout ===================== -->
            <Grid Margin="2,14,2,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <TextBlock x:Name="BigReadout"
                               Text="0"
                               FontSize="44"
                               FontWeight="Bold"
                               LineHeight="42"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource BigNumber}" />
                    <TextBlock Text="%"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DimText}"
                               Margin="3,0,0,5"
                               VerticalAlignment="Bottom" />
                </StackPanel>

                <StackPanel x:Name="HeroHint" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="Balance"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}"
                               TextAlignment="Right" />
                    <TextBlock x:Name="BalanceText"
                               FontSize="10.5"
                               Foreground="{StaticResource DimText}"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- ===================== per-ear ===================== -->
            <StackPanel x:Name="EarHost" Margin="0,8,0,0" />

            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,6,0,4" />

            <!-- ===================== master ===================== -->
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M11,5 L6,9 L2,9 L2,15 L6,15 L11,19 Z"
                              Stroke="{StaticResource DimText}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                        <Path Data="M15.5,8.5 A5,5 0 0 1 15.5,15.5"
                              Stroke="{StaticResource DimText}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>

                <Slider x:Name="MasterSlider"
                        Grid.Column="1"
                        Margin="10,0"
                        Style="{StaticResource MasterSlider}"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center"
                        ValueChanged="Master_ValueChanged" />

                <TextBlock x:Name="MasterReadout"
                           Grid.Column="2"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryText}"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- ===================== footer ===================== -->
            <Grid Height="28" Margin="0,8,0,0">
                <ToggleButton x:Name="LinkToggle"
                              Style="{StaticResource FooterToggle}"
                              HorizontalAlignment="Left"
                              IsChecked="True"
                              Click="Link_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10,13 A5,5 0 0 0 17,13 L19,11 A5,5 0 0 0 12,4 L11,5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M14,11 A5,5 0 0 0 7,11 L5,13 A5,5 0 0 0 12,20 L13,19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Linked"
                                   FontSize="11.5"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="LinkOffset"
                                   FontSize="11.5"
                                   Foreground="{StaticResource DimText}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="CentreButton"
                        Style="{StaticResource FooterButton}"
                        Content="Centre"
                        HorizontalAlignment="Right"
                        Click="Centre_Click" />
            </Grid>

            <!-- ===================== settings drawer ===================== -->
            <StackPanel x:Name="Drawer" Visibility="Collapsed" Margin="0,10,0,0">
                <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Start with Windows" FontSize="12" FontWeight="Medium" />
                        <TextBlock Text="Adds LeftRightAudioBalancer to the Startup folder."
                                   FontSize="10.5"
                                   Foreground="{StaticResource DimText}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ToggleButton x:Name="BootSwitch"
                                  Grid.Column="1"
                                  Style="{StaticResource Switch}"
                                  VerticalAlignment="Top"
                                  Margin="12,1,0,0"
                                  Click="Boot_Click" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Bluetooth per-ear fix" FontSize="12" FontWeight="Medium" />
                        <TextBlock Text="Windows hands volume to the headset, so L/R never splits. This turns that off and does volume locally. Needs admin, then a reconnect."
                                   FontSize="10.5"
                                   Foreground="{StaticResource DimText}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="FixStatus"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Bad}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,1,0,0" HorizontalAlignment="Right">
                        <Button x:Name="FixPill"
                                Style="{StaticResource Pill}"
                                Content="Apply"
                                Click="FixPill_Click" />
                        <Button x:Name="FixRevert"
                                Style="{StaticResource FooterButton}"
                                Content="Revert"
                                Height="22"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Visibility="Collapsed"
                                Click="FixRevert_Click" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Hairline}" Margin="0,12,0,12" />

                <!-- Quit: the visible way to close the app. -->
                <Button x:Name="QuitButton"
                        Style="{StaticResource QuitButton}"
                        Click="Exit_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L12,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M6.4,6.6 A9,9 0 1 0 17.6,6.6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Quit"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
